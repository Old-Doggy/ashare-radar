# 使用方式：cp .env.example .env → 在 .env 中填写 TUSHARE_TOKEN（本模板文件不要直接改）
# Tushare Pro token（必填，用于每日增量；不要提交到 git）
TUSHARE_TOKEN=

# 可选：本地 parquet 快照目录（没有就留空，改用 Tushare API）
# ASHARE_RADAR_SOURCE=./data/snapshot

# 可选：Tushare 限速覆盖（默认已按 5000 积分留 20%-40% 余量，一般不用改）
# 官方 5000 积分：整体 500 次/分钟；limit_list_d 200 次/分钟 + 1 万次/天；stock_basic 50 次/分钟
# 详见 docs/rate_limits.md
# TUSHARE_RATE_GLOBAL_PER_MIN=400
# TUSHARE_RATE_MIN_INTERVAL=0.15
# TUSHARE_RATE_LIMITS_JSON={"limit_list_d":160,"stock_basic":40}
# TUSHARE_RATE_DAILY_TOTAL_JSON={"limit_list_d":9000}
# TUSHARE_RATE_MAX_ATTEMPTS=6
# TUSHARE_RATE_BASE_DELAY=2
# 建库并行取数线程数（1=串行；默认 3；建议不超过 8）
# TUSHARE_BOOTSTRAP_WORKERS=3
